# Copy to .env. Names only here; never commit values. See docs/HUMAN_SETUP.md.

# --- PostgreSQL (local Docker, or Supabase) ---
# Zero setup: `docker compose up -d db`, then
#   DATABASE_URL=postgresql://careflow:careflow@localhost:5432/careflow
# Supabase: Project Settings > Database > Connection string > URI.
# Prefer the DIRECT connection (port 5432). If that host does not resolve, your
# network is IPv4-only and the direct host is IPv6-only: use the SESSION pooler,
# also port 5432, whose user is postgres.PROJECTREF. Avoid the TRANSACTION pooler
# (port 6543), which does not hold a session and breaks the schema search path.
# Replace [YOUR-PASSWORD] with the database password, percent-encoding any @ or /.
# Tests run in a careflow_test schema inside this same database; no second URL needed.
DATABASE_URL=postgresql://postgres:PASSWORD@db.PROJECTREF.supabase.co:5432/postgres

# --- Organization tokens (generate with: openssl rand -hex 24) ---
# value of the X-CareFlow-Token header configured on Vogent functions
CAREFLOW_DEMO_ORG_FUNCTION_TOKEN=
# path segment of the webhook URL passed at dial creation
CAREFLOW_DEMO_ORG_WEBHOOK_TOKEN=

# --- Vogent isolated workspace (secret key: backend and runner only) ---
VOGENT_API_KEY=
VOGENT_API_BASE_URL=https://api.vogent.ai/api
# written by vogent/scripts/sync.py
VOGENT_AGENT_ID=
VOGENT_V1_VERSIONED_PROMPT_ID=
VOGENT_V2_VERSIONED_PROMPT_ID=

# --- Public URL Vogent uses to reach Flask ---
BACKEND_PUBLIC_URL=https://YOUR-STATIC-DOMAIN.ngrok-free.app
# only if using ngrok
NGROK_AUTHTOKEN=

# --- Cost basis for CALCULATED_ESTIMATE figures ---
# standard voice, docs.vogent.ai/platform-overview/billing, 2026-09-18
VOGENT_RATE_USD_PER_SECOND=0.0015
VOGENT_RATE_SOURCE=https://docs.vogent.ai/platform-overview/billing

# --- Backend runtime ---
# 5000 is taken by macOS AirPlay Receiver
FLASK_PORT=5055
LOG_LEVEL=INFO

# --- Frontend (server-side only; never NEXT_PUBLIC_) ---
BACKEND_URL=http://localhost:5055
# printed by `make seed`
DEMO_ORGANIZATION_ID=

# --- Async worker (local moto SQS) ---
SQS_ENDPOINT_URL=http://localhost:5001
EVAL_QUEUE_NAME=careflow-eval-jobs
EVAL_DLQ_NAME=careflow-eval-jobs-dlq
