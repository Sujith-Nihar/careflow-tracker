# Copy to .env. Names only here; never commit values. Full guide: docs/HUMAN_SETUP.md.
#
# You need THREE things to run everything except placing new voice calls:
#   1. DATABASE_URL          a PostgreSQL you control
#   2. two org tokens        you generate them yourself; no account needed
#   3. DEMO_ORGANIZATION_ID  printed by `make seed`, paste it back in
#
# No third-party API key is required for: make test, replay, structural,
# worker-demo, tf-validate, the API or the dashboard. The Vogent and ngrok
# values at the bottom are needed only to dial again; the calls behind the
# reported results are already saved under artifacts/.


# ============================================================
# 1. REQUIRED — database
# ============================================================
# Zero setup: `docker compose up -d db` (user, password and database are all
# `careflow`, port 5432) and build the URL from those.
# Supabase: Project Settings > Database > Connection string > URI.
#   Prefer the DIRECT connection (port 5432). If that host does not resolve,
#   your network is IPv4-only and the direct host is IPv6-only: use the SESSION
#   pooler, also port 5432, whose user is postgres.PROJECTREF. Avoid the
#   TRANSACTION pooler (port 6543), which does not hold a session and breaks the
#   schema search path.
#   Replace [YOUR-PASSWORD] with the database password, percent-encoding @ or /.
# Tests run in a careflow_test schema inside this same database; no second URL.
DATABASE_URL=postgresql://postgres:PASSWORD@db.PROJECTREF.supabase.co:5432/postgres


# ============================================================
# 2. REQUIRED — organization tokens (you generate these)
# ============================================================
# Not an account or a signup: two random strings that must differ.
#   openssl rand -hex 24
# They authenticate one practice to the function endpoints. `make replay` sends
# the function token, so it is required even with no Vogent workspace.
# `make seed` refuses to run if either is missing or if they are identical.
CAREFLOW_DEMO_ORG_FUNCTION_TOKEN=
CAREFLOW_DEMO_ORG_WEBHOOK_TOKEN=


# ============================================================
# 3. REQUIRED — printed by `make seed`, then pasted back here
# ============================================================
# The dashboard reads this server-side. Without it every page returns 401.
DEMO_ORGANIZATION_ID=


# ============================================================
# 4. Defaults that already work — change only if a port clashes
# ============================================================
# 5000 is taken by macOS AirPlay Receiver.
FLASK_PORT=5055
LOG_LEVEL=INFO
# Frontend, server-side only; never NEXT_PUBLIC_.
BACKEND_URL=http://localhost:5055
# Async worker against a local moto SQS; no AWS account, no credentials.
SQS_ENDPOINT_URL=http://localhost:5001
EVAL_QUEUE_NAME=careflow-eval-jobs
EVAL_DLQ_NAME=careflow-eval-jobs-dlq
# Cost basis for the CALCULATED_ESTIMATE figures in docs/RESULTS.md.
# Standard voice, docs.vogent.ai/platform-overview/billing, read 2026-09-18.
VOGENT_RATE_USD_PER_SECOND=0.0015
VOGENT_RATE_SOURCE=https://docs.vogent.ai/platform-overview/billing


# ============================================================
# 5. OPTIONAL — only to place new Vogent voice calls
# ============================================================
# Leave every value below blank to run everything else. See HUMAN_SETUP.md §B.
# Secret key for the isolated assignment workspace; backend and runner only.
VOGENT_API_KEY=
VOGENT_API_BASE_URL=https://api.vogent.ai/api
# Written by vogent/scripts/sync_flows.py; copy its output back here.
VOGENT_AGENT_ID=
VOGENT_V1_VERSIONED_PROMPT_ID=
VOGENT_V2_VERSIONED_PROMPT_ID=
# Vogent must reach this machine to call the functions. ngrok static domain, so
# the function URLs survive a restart.
BACKEND_PUBLIC_URL=https://YOUR-STATIC-DOMAIN.ngrok-free.app
NGROK_AUTHTOKEN=
