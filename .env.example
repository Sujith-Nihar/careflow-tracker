# Copy to .env. Names only here; never commit values. See docs/HUMAN_SETUP.md.

# --- PostgreSQL (Supabase direct connection or local Docker) ---
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/postgres
TEST_DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/postgres?options=-csearch_path%3Dcareflow_test

# --- Organization tokens (generate with: openssl rand -hex 24) ---
CAREFLOW_DEMO_ORG_FUNCTION_TOKEN=      # value of the X-CareFlow-Token header configured on Vogent functions
CAREFLOW_DEMO_ORG_WEBHOOK_TOKEN=       # path segment of the webhook URL passed at dial creation

# --- Vogent isolated workspace (secret key: backend and runner only) ---
VOGENT_API_KEY=
VOGENT_API_BASE_URL=https://api.vogent.ai/api
VOGENT_AGENT_ID=                       # written by vogent/scripts/sync.py
VOGENT_V1_VERSIONED_PROMPT_ID=
VOGENT_V2_VERSIONED_PROMPT_ID=

# --- Public URL Vogent uses to reach Flask ---
BACKEND_PUBLIC_URL=https://YOUR-STATIC-DOMAIN.ngrok-free.app
NGROK_AUTHTOKEN=                       # only if using ngrok

# --- Cost basis for CALCULATED_ESTIMATE figures ---
VOGENT_RATE_USD_PER_SECOND=0.0015      # standard voice, docs.vogent.ai/platform-overview/billing, 2026-09-18
VOGENT_RATE_SOURCE=https://docs.vogent.ai/platform-overview/billing

# --- Backend runtime ---
FLASK_PORT=5000
LOG_LEVEL=INFO

# --- Frontend (server-side only; never NEXT_PUBLIC_) ---
BACKEND_URL=http://localhost:5000
DEMO_ORGANIZATION_ID=                  # printed by `make seed`

# --- Async worker (local moto SQS) ---
SQS_ENDPOINT_URL=http://localhost:5001
EVAL_QUEUE_NAME=careflow-eval-jobs
EVAL_DLQ_NAME=careflow-eval-jobs-dlq
