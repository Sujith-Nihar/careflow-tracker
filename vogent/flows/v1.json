{
  "version_name": "careflow-v1-baseline",
  "note": "V1 — a believable baseline. It announces the transfer before attempting it, then moves on unconditionally, and reports the call resolved. Nothing here is sabotage: every edge is one a reasonable builder would draw when they assume the function succeeds. It is the flow that produces the practice manager's complaint.",
  "nodes": [
    {
      "id": "greet_intake",
      "name": "Greeting and intake",
      "type": "question",
      "nodeData": {
        "question": "Thanks for calling Demo Surgical Associates. Are you calling to schedule a routine appointment, or about a concern after a recent surgery?",
        "questionType": "multiple_choice",
        "options": ["routine", "post_op", "other"],
        "clarificationDetails": "Choose routine for scheduling or rescheduling. Choose post_op for any concern about a recent operation, such as the incision, bleeding, pain, fever or swelling. Choose other for anything else."
      },
      "transitionRules": [
        {"conditionType": "equal", "value": "routine", "transitionNodeId": "collect_slot"},
        {"conditionType": "equal", "value": "post_op", "transitionNodeId": "collect_concern"},
        {"conditionType": "always", "transitionNodeId": "other_help"}
      ]
    },

    {
      "id": "collect_slot",
      "name": "Collect preferred day",
      "type": "question",
      "nodeData": {
        "question": "Which day would you like to come in?",
        "questionType": "freeform",
        "clarificationDetails": "Accept a day of the week or a date. Do not offer specific times."
      },
      "transitionRules": [{"conditionType": "always", "transitionNodeId": "book"}]
    },
    {
      "id": "book",
      "name": "Book appointment",
      "type": "function",
      "nodeData": {
        "functionId": "__schedule_appointment__",
        "inputs": [
          {"name": "patient_ref", "value": "{{patient_ref}}"},
          {"name": "preferred_date", "value": "{{node.collect_slot.output}}"},
          {"name": "reason", "value": "routine appointment"}
        ],
        "outputs": "__outputs.schedule_appointment__"
      },
      "transitionRules": [{"conditionType": "always", "transitionNodeId": "close_scheduled"}]
    },
    {
      "id": "close_scheduled",
      "name": "Confirm appointment to caller",
      "type": "freeform",
      "nodeData": {
        "prompt": "Tell the caller they are all set for {{node.collect_slot.output}} and ask if there is anything else. Then end the call politely."
      },
      "transitionRules": [{"conditionType": "always", "transitionNodeId": "disposition_resolved"}]
    },

    {
      "id": "collect_concern",
      "name": "Collect concern",
      "type": "question",
      "nodeData": {
        "question": "I'm sorry to hear that. Can you tell me briefly what's happening?",
        "questionType": "freeform",
        "clarificationDetails": "Record what the caller says. Do not interpret it and do not give any advice."
      },
      "transitionRules": [{"conditionType": "always", "transitionNodeId": "collect_phone"}]
    },
    {
      "id": "collect_phone",
      "name": "Collect callback number",
      "type": "question",
      "nodeData": {
        "question": "What's the best number to reach you on?",
        "questionType": "freeform",
        "clarificationDetails": "Capture the digits the caller says."
      },
      "transitionRules": [{"conditionType": "always", "transitionNodeId": "promise_transfer"}]
    },
    {
      "id": "promise_transfer",
      "name": "Announce the transfer",
      "type": "freeform",
      "nodeData": {
        "prompt": "Tell the caller you are connecting them to the triage nurse now. Keep it to one sentence."
      },
      "transitionRules": [{"conditionType": "always", "transitionNodeId": "transfer"}]
    },
    {
      "id": "transfer",
      "name": "Transfer to triage",
      "type": "function",
      "nodeData": {
        "functionId": "__transfer_triage__",
        "inputs": [
          {"name": "patient_ref", "value": "{{patient_ref}}"},
          {"name": "concern_summary", "value": "{{node.collect_concern.output}}"},
          {"name": "callback_phone", "value": "{{node.collect_phone.output}}"}
        ],
        "outputs": "__outputs.transfer_triage__"
      },
      "transitionRules": [{"conditionType": "always", "transitionNodeId": "close_transferred"}]
    },
    {
      "id": "close_transferred",
      "name": "Hand off",
      "type": "freeform",
      "nodeData": {
        "prompt": "Tell the caller the triage nurse will take it from here, wish them well, and end the call."
      },
      "transitionRules": [{"conditionType": "always", "transitionNodeId": "disposition_resolved"}]
    },

    {
      "id": "other_help",
      "name": "Unsupported request",
      "type": "freeform",
      "nodeData": {
        "prompt": "Explain that you can only help with scheduling and post-operative concerns, and that someone from the office can call them back. Then end the call."
      },
      "transitionRules": [{"conditionType": "always", "transitionNodeId": "disposition_unresolved"}]
    },

    {
      "id": "disposition_resolved",
      "name": "Report resolved",
      "type": "function",
      "nodeData": {
        "functionId": "__report_disposition__",
        "inputs": [
          {"name": "category", "value": "{{node.greet_intake.output}}"},
          {"name": "disposition", "value": "resolved"},
          {"name": "summary", "value": "Caller was helped and the call was completed."}
        ],
        "outputs": "__outputs.report_disposition__"
      },
      "transitionRules": []
    },
    {
      "id": "disposition_unresolved",
      "name": "Report unresolved",
      "type": "function",
      "nodeData": {
        "functionId": "__report_disposition__",
        "inputs": [
          {"name": "category", "value": "other"},
          {"name": "disposition", "value": "unresolved"},
          {"name": "summary", "value": "Caller's request was outside what the assistant handles."}
        ],
        "outputs": "__outputs.report_disposition__"
      },
      "transitionRules": []
    }
  ]
}
