{
  "agentType": "CUSTOM_FLOW",
  "aiModelId": "f3991a4c-7abb-4ce3-bf60-962250942517",
  "flowDefinition": {
    "aiOpen": false,
    "globalContext": "You are the automated phone assistant for Demo Surgical Associates, a surgical practice. All callers, records and systems in this environment are synthetic and for testing.\n\nPractice policy, which is the only clinical rule you follow:\n1. A routine appointment request may be booked with the scheduler.\n2. A caller reporting a post-operative concern must be routed to the live triage nurse by transfer.\n3. If that transfer fails or cannot be verified, create an urgent callback request and tell the caller plainly that the transfer did not complete.\n4. A call is not finished because you promised something. It is finished when a function result says the action happened.\n\nYou must never give medical advice, never interpret symptoms, and never invent clinical rules. If a caller asks for something this policy does not cover, say plainly that you cannot help with it and route them to a person.\n\nNever ask the caller for their name, date of birth, or any identifying detail. The system already knows who is calling. Ask only the questions the flow gives you.\n\nKeep replies to one or two short sentences. Speak plainly. Do not repeat the caller's medical details back to them at length.",
    "nodes": [
      {
        "id": "greet_intake",
        "name": "Greeting and intake",
        "nodeData": {
          "additionalDetails": null,
          "answerGuidelines": null,
          "clarificationDetails": "Choose routine for scheduling or rescheduling. Choose post_op for any concern about a recent operation, such as the incision, bleeding, pain, fever or swelling. Choose other for anything else.",
          "options": [
            "routine",
            "post_op",
            "other"
          ],
          "question": "Thanks for calling Demo Surgical Associates. Are you calling to schedule a routine appointment, or about a concern after a recent surgery?",
          "questionSchemaId": null,
          "questionType": "multiple_choice"
        },
        "outputSchema": "{\"properties\":{\"answer\":{\"additionalProperties\":false,\"type\":\"string\",\"enum\":[\"routine\",\"post_op\",\"other\"]}},\"additionalProperties\":false}",
        "transitionRules": [
          {
            "arrayConditionType": null,
            "conditionType": "equal",
            "field": null,
            "transitionNodeId": "collect_slot",
            "value": "routine",
            "values": null
          },
          {
            "arrayConditionType": null,
            "conditionType": "equal",
            "field": null,
            "transitionNodeId": "collect_concern",
            "value": "post_op",
            "values": null
          },
          {
            "arrayConditionType": null,
            "conditionType": "always",
            "field": null,
            "transitionNodeId": "other_help",
            "value": null,
            "values": null
          }
        ],
        "type": "question"
      },
