          "options": null,
          "question": "Which day would you like to come in?",
          "questionSchemaId": null,
          "questionType": "freeform"
        },
        "outputSchema": "{\"properties\":{\"answer\":{\"additionalProperties\":false,\"type\":\"string\"}},\"additionalProperties\":false}",
        "transitionRules": [
